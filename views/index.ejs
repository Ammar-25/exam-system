<!doctype html>
<html lang="en" class="h-full bg-gray-900 overflow-x-hidden">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Exam System - Welcome</title>
  <link rel="icon" type="image/png" href="/assets/examImg.png" />
  <link href="/output.css" rel="stylesheet">
  <link href="/style.css" rel="stylesheet">

  <style>
    .animate-in {
      animation: fadeSlideIn 0.5s ease forwards;
      opacity: 0;
    }

    .delay-1 {
      animation-delay: 0.05s;
    }

    .delay-2 {
      animation-delay: 0.1s;
    }

    .delay-3 {
      animation-delay: 0.15s;
    }

    .delay-4 {
      animation-delay: 0.2s;
    }

    @keyframes fadeSlideIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: #374151;
      border-radius: 3px;
    }
  </style>
</head>

<body class="min-h-full text-white bg-gray-900 flex flex-col">

  <header class="border-b border-white/10 bg-gray-900/80 backdrop-blur-md sticky top-0 z-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-500 text-white font-bold">
            <img src="/assets/examImg.png" alt="Exam System Logo" class="h-5 w-5">
          </div>
          <span class="text-xl font-bold tracking-tight text-white">Exam <span
              class="text-indigo-400">System</span></span>
        </div>

        <div class="flex items-center gap-4">
          <a href="/login" class="text-sm font-medium text-gray-300 hover:text-white transition-colors">
            Sign In
          </a>
          <a href="/register"
            class="inline-flex items-center gap-2 rounded-lg bg-indigo-500 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-400 active:scale-95 transition-all">
            Get Started
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-grow flex flex-col items-center justify-center relative overflow-hidden">

    <div
      class="absolute top-20 left-1/2 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-indigo-500/10 blur-[100px] pointer-events-none">
    </div>
    <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-violet-500/10 blur-[100px] pointer-events-none">
    </div>

    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 relative z-10 w-full text-center">

      <div class="max-w-3xl mx-auto flex flex-col items-center gap-6">
        <div
          class="animate-in inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-sm font-medium text-indigo-400 mb-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
          </span>
          Next-Generation Assessment Platform
        </div>

        <h1 class="animate-in delay-1 text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
          The smarter way
          <br class="hidden sm:block" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-violet-400">
            to run exams</span>
        </h1>

        <p class="animate-in delay-2 text-lg text-gray-400 max-w-2xl">
          A complete assessment platform for students and educators. Create, take, and analyse exams with full transparency and
          real-time feedback.
        </p>

        <div class="animate-in delay-3 flex flex-col sm:flex-row items-center gap-4 mt-4 w-full sm:w-auto">
          <a href="/register"
            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 rounded-lg bg-indigo-500 px-8 py-3.5 text-base font-semibold text-white hover:bg-indigo-400 active:scale-95 transition-all shadow-[0_0_20px_rgba(99,102,241,0.3)] hover:shadow-[0_0_25px_rgba(99,102,241,0.5)]">
            Create Student Account
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="/login"
            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-8 py-3.5 text-base font-semibold text-white hover:bg-white/10 active:scale-95 transition-all">
            Exam System Login
          </a>
        </div>
      </div>

      <div class="mt-24 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">

        <div
          class="animate-in delay-2 rounded-2xl border border-white/10 bg-white/5 p-8 text-left hover:bg-white/10 transition-colors group">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-500/20 text-emerald-400 mb-6 group-hover:scale-110 transition-transform">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Secure Authentication</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            State-of-the-art token security ensures that your sessions, data, and examination attempts are protected
            with bank-level encryption.
          </p>
        </div>

        <div
          class="animate-in delay-3 rounded-2xl border border-white/10 bg-white/5 p-8 text-left hover:bg-white/10 transition-colors group">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-500/20 text-indigo-400 mb-6 group-hover:scale-110 transition-transform">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Automated Grading</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Receive instant, accurate results the moment you submit. Our backend logic processes complex answers in
            milliseconds, saving you the wait.
          </p>
        </div>

        <div
          class="animate-in delay-4 rounded-2xl border border-white/10 bg-white/5 p-8 text-left hover:bg-white/10 transition-colors group">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-500/20 text-violet-400 mb-6 group-hover:scale-110 transition-transform">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Detailed Analytics</h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            Track your progress across subjects. Our dashboard provides comprehensive insights into your strengths and
            areas for improvement.
          </p>
        </div>

      </div>
    </div>
  </main>

  <footer class="border-t border-white/10 bg-gray-900/50 mt-auto py-8">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm text-gray-500">
        &copy;
        <script>document.write(new Date().getFullYear())</script> Exam System Portal. All rights reserved.
      </p>
    </div>
  </footer>

</body>

</html>